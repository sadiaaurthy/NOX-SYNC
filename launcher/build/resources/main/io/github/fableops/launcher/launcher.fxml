<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" styleClass="stage" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="io.github.fableops.launcher.LauncherController"
           prefWidth="1000" prefHeight="680">

    <Canvas fx:id="starsCanvas" />

    <VBox>
        <HBox styleClass="chrome-bar" alignment="CENTER_LEFT" spacing="16">
            <Label styleClass="chrome-text" text="SEC.NODE // " />
            <Label styleClass="chrome-accent" text="REACTOR.LOCKOUT" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="clockLabel" styleClass="chrome-text" text="00:00:00" />
            <Label styleClass="chrome-text" text="&#9632; LINK IDLE" />
        </HBox>
    </VBox>

    <StackPane StackPane.alignment="CENTER_RIGHT">
        <VBox styleClass="panel-column" maxWidth="430" alignment="CENTER_LEFT" StackPane.alignment="CENTER_RIGHT">

            <Label styleClass="eyebrow" text="&#9632; ACCESS TERMINAL 03" />

            <HBox fx:id="titleBox" styleClass="title-box" />

            <Region styleClass="title-underline" maxWidth="96" minHeight="5" />

            <VBox styleClass="pixel-panel" spacing="8">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="panel-label" text="SELECT OPERATION" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="panel-marks" text="&#9632;&#9632;&#9633;" />
                </HBox>

                <Button fx:id="hostButton" styleClass="op-btn, accent-orange" maxWidth="Infinity" onAction="#onHost">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="H" />
                            <Label styleClass="op-label" text="Host session" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="joinLanButton" styleClass="op-btn, accent-cyan" maxWidth="Infinity" onAction="#onJoinLan">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="J" />
                            <Label styleClass="op-label" text="Join over LAN" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="joinLocalButton" styleClass="op-btn, accent-cyan" maxWidth="Infinity" onAction="#onJoinLocal">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="L" />
                            <Label styleClass="op-label" text="Join local (127.0.0.1)" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="debugButton" styleClass="op-btn, accent-magenta" maxWidth="Infinity" onAction="#onDebug">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="D" />
                            <Label styleClass="op-label" text="Debug — no network" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <HBox styleClass="ip-row" alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="panel-label" text="HOST IP" />
                    <TextField fx:id="ipField" styleClass="ip-field" promptText="192.168.1.•••" onAction="#onJoinLan" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <HBox styleClass="status-row" alignment="CENTER_LEFT">
                <Label fx:id="statusLabel" styleClass="status-text" text="&#9632; awaiting connection…" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="status-text" text="build 2026.08.01" />
            </HBox>

        </VBox>
    </StackPane>

</StackPane>
