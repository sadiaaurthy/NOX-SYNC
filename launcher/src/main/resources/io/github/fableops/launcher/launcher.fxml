<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" styleClass="stage" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="io.github.fableops.launcher.LauncherController"
           prefWidth="1000" prefHeight="680">

    <Canvas fx:id="starsCanvas" />

    <VBox>
        <HBox styleClass="chrome-bar" alignment="CENTER_LEFT" spacing="16">
            <Label styleClass="chrome-text" text="SEC.NODE // " />
            <Label styleClass="chrome-accent" text="REACTOR.LOCKOUT" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="clockLabel" styleClass="chrome-text" text="00:00:00" />
            <Label styleClass="chrome-text" text="&#9632; LINK IDLE" />
        </HBox>
    </VBox>

    <StackPane StackPane.alignment="CENTER">
      <HBox alignment="CENTER" spacing="30">
        <VBox styleClass="panel-column" maxWidth="430" alignment="CENTER_LEFT">

            <Label styleClass="eyebrow" text="&#9632; ACCESS TERMINAL 03" />

            <HBox fx:id="titleBox" styleClass="title-box" />

            <Region styleClass="title-underline" maxWidth="96" minHeight="5" />

            <VBox styleClass="pixel-panel" spacing="8">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="panel-label" text="SELECT OPERATION" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label styleClass="panel-marks" text="&#9632;&#9632;&#9633;" />
                </HBox>

                <Button styleClass="op-btn, accent-orange" maxWidth="Infinity" onAction="#onHost">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="H" />
                            <Label styleClass="op-label" text="Host session" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="op-btn, accent-cyan" maxWidth="Infinity" onAction="#onJoinLan">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="J" />
                            <Label styleClass="op-label" text="Join over LAN" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="op-btn, accent-cyan" maxWidth="Infinity" onAction="#onJoinLocal">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="L" />
                            <Label styleClass="op-label" text="Join local (127.0.0.1)" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <Button styleClass="op-btn, accent-magenta" maxWidth="Infinity" onAction="#onDebug">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label styleClass="op-key" text="D" />
                            <Label styleClass="op-label" text="Debug — no network" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label styleClass="op-arrow" text="&#9654;" />
                        </HBox>
                    </graphic>
                </Button>

                <HBox styleClass="ip-row" alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="panel-label" text="HOST IP" />
                    <TextField fx:id="ipField" styleClass="ip-field" promptText="192.168.1.•••" onAction="#onJoinLan" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <HBox styleClass="status-row" alignment="CENTER_LEFT">
                <Label fx:id="statusLabel" styleClass="status-text" text="&#9632; awaiting connection…" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="status-text" text="build 2026.08.01" />
            </HBox>

        </VBox>

        <!-- Every in-game binding. -->
        <VBox styleClass="pixel-panel, controls-panel" spacing="8" maxWidth="520">
            <Label styleClass="panel-label" text="CONTROLS" />

            <HBox spacing="26">
                <VBox styleClass="controls-col" spacing="3">
                    <Label styleClass="controls-head" text="MOVE" />
                    <HBox spacing="10"><Label styleClass="controls-key" text="W A S D" /><Label styleClass="controls-desc" text="Player 1" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="ARROWS" /><Label styleClass="controls-desc" text="Player 2" /></HBox>

                    <Label styleClass="controls-head" text="FIGHT" />
                    <HBox spacing="10"><Label styleClass="controls-key" text="F" /><Label styleClass="controls-desc" text="Player 1 attack" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="R-SHIFT" /><Label styleClass="controls-desc" text="Player 2 attack" /></HBox>

                    <Label styleClass="controls-head" text="WORLD" />
                    <HBox spacing="10"><Label styleClass="controls-key" text="E" /><Label styleClass="controls-desc" text="Terminal / core" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="1" /><Label styleClass="controls-desc" text="Player 1 inventory" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="2" /><Label styleClass="controls-desc" text="Player 2 inventory" /></HBox>

                    <Label styleClass="controls-head" text="SYSTEM" />
                    <HBox spacing="10"><Label styleClass="controls-key" text="F1" /><Label styleClass="controls-desc" text="Collision overlay" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="F2" /><Label styleClass="controls-desc" text="UI size / projector" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="K" /><Label styleClass="controls-desc" text="Skip stage (debug)" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="ESC" /><Label styleClass="controls-desc" text="Back / quit" /></HBox>
                </VBox>

                <VBox styleClass="controls-col" spacing="3">
                    <Label styleClass="controls-head" text="TERMINAL" />
                    <HBox spacing="10"><Label styleClass="controls-key" text="TAB" /><Label styleClass="controls-desc" text="Next position" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="0 - 9" /><Label styleClass="controls-desc" text="Enter digit" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="BKSP" /><Label styleClass="controls-desc" text="Delete digit" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="ENTER" /><Label styleClass="controls-desc" text="Submit" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="SPACE" /><Label styleClass="controls-desc" text="Switch terminal" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="ESC" /><Label styleClass="controls-desc" text="Close" /></HBox>

                    <Label styleClass="controls-head" text="INVENTORY" />
                    <HBox spacing="10"><Label styleClass="controls-key" text="WASD / ARR" /><Label styleClass="controls-desc" text="Move cursor" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="TAB" /><Label styleClass="controls-desc" text="Shared slot" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="R" /><Label styleClass="controls-desc" text="Put / take" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="ENTER" /><Label styleClass="controls-desc" text="Use item" /></HBox>
                    <HBox spacing="10"><Label styleClass="controls-key" text="ESC" /><Label styleClass="controls-desc" text="Close" /></HBox>
                </VBox>
            </HBox>
        </VBox>
      </HBox>
    </StackPane>

</StackPane>
