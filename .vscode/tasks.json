{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run FableOps",
            "type": "shell",

            "command": "./gradlew",

            "windows": {
                "command": ".\\gradlew.bat"
            },

            "args": [
                ":launcher:run"
            ],

            "options": {
                "cwd": "${workspaceFolder}"
            },

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "presentation": {
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },

            "problemMatcher": []
        }
    ]
}